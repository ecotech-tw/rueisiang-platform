# Set this to the public HTTPS origin of the deployed HR API Worker.
RFID_API_ORIGIN=https://platform.rueisiang.com

# Use the same high-entropy secret in the HR API Worker and this NAS gateway.
RFID_GATEWAY_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# One stable identifier per reader.
RFID_DEVICE_ID=office-entrance

# Exact active attendance-location name in HR.
RFID_ATTENDANCE_LOCATION_NAME=瑞香雲林總部

# NAS LAN address; reserve this address in DHCP or configure it statically.
RFID_TCP_BIND=192.168.0.6
