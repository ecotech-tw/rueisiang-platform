# 複製成 .env 後填入。.env 已被 .gitignore 排除，不要納入版控。

# CYBERBIZ 後台帳密
CYBERBIZ_USERNAME=
CYBERBIZ_PASSWORD=

# CYBERBIZ 登入 2FA 驗證碼會寄到的信箱（僅供對照，實際讀信走 GMAIL_REFRESH_TOKEN）
CYBERBIZ_2FA_MAILBOX=

# Google OAuth 用戶端（桌面應用程式類型，由 setup.mjs 從 Downloads 自動帶入）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 存放出金表的 Drive 帳號（node setup.mjs auth 產生）
GOOGLE_REFRESH_TOKEN=

# 收 2FA 驗證信與 CYBERBIZ 報表附件的信箱（node setup.mjs mail 產生）
GMAIL_REFRESH_TOKEN=

# Monthly normalized report publish（NAS 上線後才需要）
NAS_STORAGE_URL=https://storage.rueisiang.com
NAS_STORAGE_TOKEN=
PLATFORM_API_URL=https://platform.rueisiang.com
CYBERBIZ_REPORT_INGEST_TOKEN=
# 僅供平台 MCP client 設定；monthly runner 不需要這個值
CYBERBIZ_REPORT_MCP_TOKEN=
